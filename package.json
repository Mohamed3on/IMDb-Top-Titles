{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "imdb-episodes",
  "title": "IMDb Episodes",
  "description": "Find top-rated episodes of any TV show",
  "icon": "extension-icon.png",
  "author": "mohamed",
  "license": "MIT",
  "commands": [
    {
      "name": "search-show",
      "title": "Search Show Episodes",
      "description": "Fetch and rank IMDb episodes by score",
      "mode": "view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Show name or IMDb URL",
          "type": "text",
          "required": false
        },
        {
          "name": "minRatio",
          "placeholder": "Min ratio (default: 0)",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^1.93.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2",
    "@raycast/utils": "^1.18.0",
    "@types/node": "~20.14.0",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5.4.0"
  }
}
